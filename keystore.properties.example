# 复制本文件为 keystore.properties 并填入真实值。
# keystore.properties 已被 .gitignore 忽略，不要提交，也不要发给别人。
#
# 生成密钥库（示例，路径自行替换）：
# keytool -genkeypair -v -keystore personal-ai-vault-release.jks \
#   -alias personal-ai-vault -keyalg RSA -keysize 2048 -validity 10000
#
# 密钥库和两个密码必须一起备份：丢了就无法再给已安装的用户发布升级包。
storeFile=C:/Users/你的用户名/.android/personal-ai-vault-release.jks
storePassword=替换为密钥库密码
keyAlias=personal-ai-vault
keyPassword=替换为密钥密码
